<style>
*{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;background:#1a1a1a;display:flex;justify-content:center;align-items:flex-start;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;}
.app{width:100%;max-width:430px;min-height:100vh;background:#FFFAF6;display:flex;flex-direction:column;position:relative;}
.sbar{background:#F5EDE0;padding:12px 20px 8px;display:flex;justify-content:space-between;align-items:center;font-size:12px;font-weight:500;color:#5F5040;flex-shrink:0;}
.scroll{flex:1;overflow-y:auto;background:#FFFAF6;}
.screen{display:none;flex-direction:column;height:100vh;}
.screen.active{display:flex;}
.hero{background:#F5EDE0;padding:22px 20px 24px;}
.badge{display:inline-flex;align-items:center;gap:5px;background:#C9896A;color:#FFF8F2;font-size:11px;font-weight:500;padding:4px 11px;border-radius:20px;margin-bottom:12px;}
.hero-h{font-size:22px;font-weight:500;color:#3D2210;line-height:1.3;margin-bottom:8px;}
.hero-p{font-size:13px;color:#7A5A40;line-height:1.65;margin-bottom:20px;}
.btn-brown{background-color:#7A4F2E;color:#FFFFFF;border-radius:12px;padding:14px 16px;font-size:15px;font-weight:500;width:100%;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:8px;user-select:none;}
.btn-label{display:flex;align-items:center;gap:8px;}
.btn-arr{width:28px;height:28px;background-color:rgba(255,255,255,0.25);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.booking-banner{margin:14px 20px 0;border-radius:14px;padding:13px 14px;display:flex;align-items:center;gap:12px;cursor:pointer;}
.booking-banner.has-booking{background:#FFF8F2;border:1px solid #C9896A;}
.booking-banner.no-booking{background:#F5F5F5;border:1px solid #D3C4B0;}
.ab-dot-active{width:10px;height:10px;background:#C9896A;border-radius:50%;flex-shrink:0;}
.ab-dot-empty{width:10px;height:10px;background:#D3C4B0;border-radius:50%;flex-shrink:0;}
.sh{padding:18px 20px 4px;}
.sh-t{font-size:16px;font-weight:500;color:#3D2210;margin-bottom:3px;}
.sh-s{font-size:12px;color:#A08060;margin-bottom:12px;}
.cond-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:0 20px 6px;}
.ccard{background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:12px;padding:10px 6px;cursor:pointer;display:flex;flex-direction:column;align-items:center;text-align:center;-webkit-tap-highlight-color:transparent;}
.ccard:active{border-color:#C9896A;background:#FAF0E6;}
.ccard-img{width:62px;height:62px;margin-bottom:6px;}
.cc-n{font-size:11px;font-weight:500;color:#3D2210;line-height:1.3;}
.tlist{padding:0 20px 20px;}
.tcard{background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:14px;padding:14px;margin-bottom:10px;}
.thead2{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.tav{width:42px;height:42px;border-radius:50%;background:#EDD9C0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;color:#7A4F2E;flex-shrink:0;}
.tnm{font-size:13px;font-weight:500;color:#3D2210;}
.tmt{font-size:11px;color:#A08060;}
.tstars{display:flex;gap:1px;margin-left:auto;}
.tst{font-size:13px;color:#C9896A;}
.ttxt{font-size:12px;color:#5F4030;line-height:1.65;}
.bnav{background:#F5EDE0;border-top:0.5px solid #D3C4B0;display:flex;padding:10px 0 20px;flex-shrink:0;}
.bni{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;-webkit-tap-highlight-color:transparent;}
.bni-ic{font-size:22px;color:#B0907A;}
.bni-ic.on{color:#7A4F2E;}
.bni-lb{font-size:10px;color:#B0907A;}
.bni-lb.on{color:#7A4F2E;font-weight:500;}
.back-row{display:flex;align-items:center;gap:10px;padding:12px 20px;background:#F5EDE0;border-bottom:0.5px solid #D3C4B0;flex-shrink:0;}
.back-btn{background:none;border:none;cursor:pointer;color:#7A4F2E;font-size:20px;padding:0;line-height:1;}
.help-row{display:flex;gap:9px;align-items:flex-start;background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:10px;padding:11px 12px;margin-bottom:8px;}
.tips-box{margin:14px 20px 0;background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:12px;padding:14px;}
.tips-lbl{font-size:12px;font-weight:500;color:#A08060;margin-bottom:6px;}
.tips-txt{font-size:13px;color:#5F4030;line-height:1.65;}
.prog-wrap{padding:14px 20px 10px;background:#F5EDE0;flex-shrink:0;}
.prog-lbl{font-size:11px;color:#A08060;margin-bottom:5px;display:flex;justify-content:space-between;}
.prog-track{height:4px;background:#D3C4B0;border-radius:4px;overflow:hidden;}
.prog-fill{height:100%;background:#7A4F2E;border-radius:4px;transition:width 0.3s;}
.opt-list{display:flex;flex-direction:column;gap:8px;padding:0 20px;}
.opt{background:#FFF8F2;border:1px solid #D3C4B0;border-radius:12px;padding:13px 14px;cursor:pointer;display:flex;align-items:center;justify-content:space-between;font-size:14px;color:#3D2210;-webkit-tap-highlight-color:transparent;}
.opt.sel{border:2px solid #7A4F2E;background:#FAF0E6;color:#7A4F2E;font-weight:500;}
.opt-chk{font-size:16px;color:#7A4F2E;display:none;}
.opt.sel .opt-chk{display:block;}
.nxt-wrap{padding:16px 20px 24px;display:flex;gap:10px;}
.bk-input{width:100%;padding:13px 14px;background:#FFFFFF;border:1.5px solid #D3C4B0;border-radius:12px;font-size:14px;color:#3D2210;outline:none;}
.bk-input:focus{border-color:#7A4F2E;}
.bk-textarea{width:100%;padding:13px 14px;background:#FFFFFF;border:1.5px solid #D3C4B0;border-radius:12px;font-size:14px;color:#3D2210;outline:none;resize:none;height:100px;}
.bk-textarea:focus{border-color:#7A4F2E;}
.pain-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;padding:0 20px;}
.pain-num{background:#FFF8F2;border:1px solid #D3C4B0;border-radius:10px;padding:12px 4px;text-align:center;cursor:pointer;font-size:15px;font-weight:500;color:#3D2210;}
.pain-num.sel{border:2px solid #7A4F2E;background:#FAF0E6;color:#7A4F2E;}
.prev-btn{background:#F5EDE0;color:#7A4F2E;border:1.5px solid #D3C4B0;border-radius:12px;padding:14px 16px;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px;flex-shrink:0;}
.date-row{display:flex;gap:8px;padding:6px 20px 14px;overflow-x:auto;}
.dchip{flex-shrink:0;background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:10px;padding:8px 13px;text-align:center;cursor:pointer;}
.dchip.on{background:#7A4F2E;border-color:#7A4F2E;}
.dday{font-size:10px;color:#A08060;}
.dnum{font-size:15px;font-weight:500;color:#3D2210;}
.dchip.on .dday,.dchip.on .dnum{color:#FFF8F2;}
.slot-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:0 20px;}
.slot{background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:10px;padding:10px 4px;text-align:center;cursor:pointer;font-size:13px;color:#3D2210;}
.slot.sel{border:1.5px solid #7A4F2E;background:#FAF0E6;color:#7A4F2E;font-weight:500;}
.cf-body{padding:28px 20px;display:flex;flex-direction:column;align-items:center;}
.cf-ic{width:68px;height:68px;background:#EDD9C0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:34px;color:#7A4F2E;margin-bottom:16px;}
.cf-card{background:#FFF8F2;border:0.5px solid #D3C4B0;border-radius:14px;padding:16px;width:100%;margin-bottom:20px;}
.cf-row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:0.5px solid #EDD9C0;font-size:13px;}
.cf-row:last-child{border-bottom:none;}
</style>
</head>
